<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nurtura_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/babyScheduleBackButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/baby_accent"
            app:backgroundTint="@android:color/transparent" />

        <View
            android:layout_width="52dp"
            android:layout_height="5dp"
            android:layout_marginTop="8dp"
            android:background="@color/baby_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/baby_schedule_screen_title"
            android:textColor="@color/nurtura_text"
            android:textSize="28sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/baby_light"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/baby_accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/baby_birth_details"
                    android:textColor="@color/nurtura_text"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/babyAgeTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/babyBirthDateButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="15dp"
                    android:text="@string/select_baby_birth_date"
                    android:textAllCaps="false"
                    android:textColor="@color/baby_accent"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/baby_accent" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="28dp"
                android:background="@color/baby_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/official_vaccination_schedule"
                android:textColor="@color/nurtura_text"
                android:textSize="20sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/scheduleNeedsBirthDateTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/baby_light"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/vaccination_schedule_needs_birth_date"
            android:textColor="@color/nurtura_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/officialVaccineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nurtura_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/baby_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addCustomVaccinationButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/add_custom_vaccination"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/baby_accent"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addBabyAppointmentButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/add_baby_appointment"
                    android:textAllCaps="false"
                    android:textColor="@color/baby_accent"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/baby_accent" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/babyScheduleProgressIndicator"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:indicatorColor="@color/baby_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="26dp"
                android:background="@color/baby_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/additional_vaccinations"
                android:textColor="@color/nurtura_text"
                android:textSize="19sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/noCustomVaccinationsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/baby_light"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/no_additional_vaccinations"
            android:textColor="@color/nurtura_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/customVaccinationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="26dp"
                android:background="@color/baby_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/upcoming_baby_appointments"
                android:textColor="@color/nurtura_text"
                android:textSize="19sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/noBabyAppointmentsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/baby_light"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/no_baby_appointments"
            android:textColor="@color/nurtura_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/babyAppointmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/baby_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="15dp"
                android:text="@string/baby_schedule_notice"
                android:textColor="@color/nurtura_text_secondary"
                android:textSize="12sp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>