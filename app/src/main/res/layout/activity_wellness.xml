<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nurtura_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wellnessBackButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:textColor="@color/nurtura_primary"
            app:backgroundTint="@android:color/transparent"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wellness_title"
            android:textColor="@color/nurtura_text"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/wellness_subtitle"
            android:textColor="@color/nurtura_text_secondary"
            android:textSize="15sp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/wellness_light"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/wellness_accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wellness_summary"
                    android:textColor="@color/nurtura_text"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/average_sleep"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/averageSleepTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_wellness_data"
                    android:textColor="@color/nurtura_text"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/average_water"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/averageWaterTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_wellness_data"
                    android:textColor="@color/nurtura_text"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/common_mood"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/commonMoodTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_wellness_data"
                    android:textColor="@color/nurtura_text"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wellness_insight"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/wellnessInsightTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_wellness_data"
                    android:textColor="@color/nurtura_text"
                    android:textSize="15sp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/nurtura_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/nurtura_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_check_in"
                    android:textColor="@color/nurtura_text"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/mood"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="14sp"/>

                <Spinner
                    android:id="@+id/wellnessMoodSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:entries="@array/mood_levels"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/energy_level"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="14sp"/>

                <Spinner
                    android:id="@+id/energySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:entries="@array/energy_levels"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sleep_hours"
                        android:textColor="@color/nurtura_text"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/sleepValueTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_wellness_data"
                        android:textColor="@color/wellness_accent"
                        android:textStyle="bold"/>

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sleepSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/water_glasses"
                        android:textColor="@color/nurtura_text"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/waterValueTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_wellness_data"
                        android:textColor="@color/wellness_accent"
                        android:textStyle="bold"/>

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/waterSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/nurtura_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/wellnessNotesEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="@string/wellness_symptoms_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="3"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveWellnessButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/save_wellness_check_in"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/nurtura_primary"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/wellnessProgressIndicator"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:indicatorColor="@color/wellness_accent"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/nurtura_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/nurtura_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekly_wellness_chart"
                    android:textColor="@color/nurtura_text"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/weekly_chart_subtitle"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="13sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/chart_sleep"
                        android:textColor="@color/wellness_accent"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/chart_water"
                        android:textColor="@color/baby_accent"
                        android:textStyle="bold"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/chartEmptyTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:text="@string/no_chart_data"
                    android:textColor="@color/nurtura_text_secondary"/>

                <LinearLayout
                    android:id="@+id/weeklyChartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/recent_wellness_entries"
            android:textColor="@color/nurtura_text"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/wellnessEmptyTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/no_wellness_entries"
            android:textColor="@color/nurtura_text_secondary"/>

        <LinearLayout
            android:id="@+id/wellnessEntriesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/wellness_disclaimer"
            android:textColor="@color/nurtura_text_secondary"
            android:textSize="12sp"/>

    </LinearLayout>
</ScrollView>