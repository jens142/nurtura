<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nurtura_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/babyBackButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:textColor="@color/nurtura_primary"
            app:backgroundTint="@android:color/transparent"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/baby_title"
            android:textColor="@color/nurtura_text"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/baby_subtitle"
            android:textColor="@color/nurtura_text_secondary"
            android:textSize="15sp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/baby_light"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/baby_accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/baby_summary"
                    android:textColor="@color/nurtura_text"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/records_today"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/todayRecordsTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/nurtura_text"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/latest_activity"
                    android:textColor="@color/nurtura_text_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/latestBabyActivityTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not_recorded"
                    android:textColor="@color/nurtura_text"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/quick_log"
            android:textColor="@color/nurtura_text"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/quick_log_help"
            android:textColor="@color/nurtura_text_secondary"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feedButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/feed"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:backgroundTint="@color/baby_accent"
                app:cornerRadius="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diaperButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/diaper"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:backgroundTint="@color/baby_accent"
                app:cornerRadius="16dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sleepButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/sleep"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:backgroundTint="@color/baby_accent"
                app:cornerRadius="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bathButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/bath"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:backgroundTint="@color/baby_accent"
                app:cornerRadius="16dp"/>

        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/babyProgressIndicator"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:indicatorColor="@color/baby_accent"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/recent_baby_records"
            android:textColor="@color/nurtura_text"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/babyEmptyTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/no_baby_records"
            android:textColor="@color/nurtura_text_secondary"/>

        <LinearLayout
            android:id="@+id/babyEntriesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"/>

    </LinearLayout>
</ScrollView>